{
  "name": "racing-action-game",
  "version": "0.1.0",
  "private": true,
  "description": "Racing + action browser game (HTML5, Phaser 3, TypeScript). See docs/SPEC.md.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "art": "node scripts/build-art.mjs",
    "test:mobile": "node scripts/smoke-mobile.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
